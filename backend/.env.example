# ---------------------------------------------------------------------------
# Local development defaults.
#
# For PRODUCTION, override at minimum:
#   APP_ENV=production
#   APP_DEBUG=false
#   APP_URL=https://your-domain
#   FRONTEND_URL=https://app.your-domain
#   APP_KEY / JWT_SECRET              (php artisan key:generate && jwt:secret)
#   DB_*                               (managed Postgres; DB_SSLMODE=require)
#   SESSION_SECURE_COOKIE=true
#   SESSION_ENCRYPT=true
#   CORS_ALLOWED_ORIGINS=https://app.your-domain   (never '*')
#   MAIL_* / MAIL_MAILER=smtp|ses|postmark|resend  (never 'log')
#   STRIPE_* / PAYPAL_*                (PAYPAL_MODE=live)
#   AI provider key for AI_PROVIDER
# Then run:  php artisan app:production-check
# Secrets must come from the deployment secret store, never from Git.
# ---------------------------------------------------------------------------

APP_NAME="AI Customer Support"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Application encryption key history (comma separated) used when rotating APP_KEY
APP_PREVIOUS_KEYS=

LOG_CHANNEL=stack
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null

# Comma-separated list of allowed browser origins. NEVER use '*' in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT authentication secret. Generate with: php artisan jwt:secret
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=ai_customer_support
# DB_USERNAME=postgres
# DB_PASSWORD=
# DB_SSLMODE=prefer
# Session timezone for PostgreSQL connections. Keep in sync with APP_TIMEZONE.
DB_TIMEZONE=UTC

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids

CACHE_STORE=database
# CACHE_PREFIX=

# Platform notifications (Super Admin notification center)
PLATFORM_NOTIFICATIONS_ENABLED=true
PLATFORM_NOTIFICATIONS_DEDUPE_TTL=3600
PLATFORM_NOTIFICATIONS_PER_PAGE=20
PLATFORM_NOTIFICATIONS_MAX_PER_PAGE=100
PLATFORM_NOTIFICATIONS_RETENTION_DAYS=90

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail transport. Development uses 'log' (emails are written to the log only).
# Production MUST use a real transport (smtp|ses|postmark|resend) and a real
# MAIL_FROM_ADDRESS on a verified domain.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Payments (leave disabled for local development).
# ---------------------------------------------------------------------------
STRIPE_ENABLED=false
# STRIPE_KEY=
# STRIPE_SECRET=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_API_VERSION=2024-06-20

PAYPAL_ENABLED=false
PAYPAL_MODE=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# PAYPAL_CURRENCY=USD

# Where the payment provider redirects the browser after checkout.
PAYMENT_SUCCESS_URL="${FRONTEND_URL}/billing/success"
PAYMENT_CANCEL_URL="${FRONTEND_URL}/billing/cancel"

# ---------------------------------------------------------------------------
# AI providers. Set AI_PROVIDER and provide the matching API key.
# ---------------------------------------------------------------------------
AI_ENABLED=true
AI_PROVIDER=openai
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# AI provider health probe. Disabled by default to avoid live provider calls
# (cost / rate-limit) during routine health checks. Enable deliberately.
HEALTH_AI_PROBE=false

# Database backup freshness. The backup job (backend/scripts/backup-databases.sh)
# writes BACKUP_MARKER_PATH on success; enable the check and point it there to
# surface stale or missing backups on the dashboard.
HEALTH_BACKUP_CHECK_ENABLED=false
BACKUP_MARKER_PATH=
BACKUP_MAX_AGE_HOURS=26

# ---------------------------------------------------------------------------
# Object storage (production uploads should use s3, not the local disk).
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
